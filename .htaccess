# InfinityFree / Apache front-controller routing.
# All clean URLs, including /login and /api/*, run through public/index.php.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Avoid a second rewrite after Apache has entered the public front controller.
    RewriteRule ^public/ - [L]

    RewriteRule ^(.*)$ public/index.php [QSA,L]
</IfModule>
