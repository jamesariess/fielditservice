# Block direct HTTP access to page files.
# Pages are loaded through the router (public/index.php) via the filesystem,
# which enforces authentication, permissions, and the app bootstrap.
# Direct browser access would bypass all of that.
#
# Instead of an ugly Apache 403, blocked requests are handed to the
# front controller as a RELATIVE target, which maps the file back to its clean
# route and redirects (e.g. /public/pages/auth/login.php -> /login).
# Unknown files still get the router's 404.
#
# The old version used an absolute path:
#     ErrorDocument 403 /fielditservice/public/index.php
#     Require all denied
# which only exists when the app sits in a folder called "fielditservice". On a
# domain-root host (InfinityFree, most shared hosting) that file is not there,
# so Apache answered the 403 with a 404 for a path the browser never asked for:
# an unexplainable "Failed to load resource: 404".
#
# "../index.php" resolves correctly for every install style:
#   docroot = public/          /pages/x.php            -> /index.php
#   docroot = project root     /public/pages/x.php     -> /public/index.php
#   XAMPP sub-folder install   /app/public/pages/x.php -> /app/public/index.php
#
# The rewrite is unconditional, so no page file can execute directly even
# without a blanket deny. (Every page also refuses to run without APP_ROOT.)
RewriteEngine On
RewriteRule ^(.*)$ ../index.php [QSA,L]